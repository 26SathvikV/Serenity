            {n:'Kuala Lumpur',     iana:'Asia/Kuala_Lumpur'},
            {n:'Singapore',        iana:'Asia/Singapore'},
            {n:'Manila',           iana:'Asia/Manila'},
            {n:'Shanghai',         iana:'Asia/Shanghai'},
            {n:'Beijing',          iana:'Asia/Shanghai'},
            {n:'Chengdu',          iana:'Asia/Shanghai'},
            {n:'Guangzhou',        iana:'Asia/Shanghai'},
            {n:'Shenzhen',         iana:'Asia/Shanghai'},
            {n:'Hong Kong',        iana:'Asia/Hong_Kong'},
            {n:'Taipei',           iana:'Asia/Taipei'},
            {n:'Macau',            iana:'Asia/Macau'},
            {n:'Ulaanbaatar',      iana:'Asia/Ulaanbaatar'},
            {n:'Tokyo',            iana:'Asia/Tokyo'},
            {n:'Osaka',            iana:'Asia/Tokyo'},
            {n:'Kyoto',            iana:'Asia/Tokyo'},
            {n:'Seoul',            iana:'Asia/Seoul'},
            {n:'Pyongyang',        iana:'Asia/Pyongyang'},
            {n:'Perth',            iana:'Australia/Perth'},
            {n:'Adelaide',         iana:'Australia/Adelaide'},
            {n:'Darwin',           iana:'Australia/Darwin'},
            {n:'Sydney',           iana:'Australia/Sydney'},
            {n:'Melbourne',        iana:'Australia/Melbourne'},
            {n:'Brisbane',         iana:'Australia/Brisbane'},
            {n:'Canberra',         iana:'Australia/Sydney'},
            {n:'Auckland',         iana:'Pacific/Auckland'},
            {n:'Wellington',       iana:'Pacific/Auckland'},
            {n:'Christchurch',     iana:'Pacific/Auckland'},
            {n:'Suva',             iana:'Pacific/Fiji'},
            {n:'Port Moresby',     iana:'Pacific/Port_Moresby'},
            {n:'Guam',             iana:'Pacific/Guam'},
            {n:'Apia',             iana:'Pacific/Apia'},
        ];

        var canvas = document.getElementById('tzCanvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        var hoveredOff = null, selectedOff = null;
        var timezoneInput = document.getElementById('tzHiddenInput');
        var currentTz = timezoneInput.value || Intl.DateTimeFormat().resolvedOptions().timeZone;
        if (!timezoneInput.value) {
            timezoneInput.value = currentTz;
            document.getElementById('tzPreferenceLabel').textContent = 'Using device timezone: ' + currentTz;
            document.getElementById('tzCurrentLabel').textContent = currentTz + ' detected from this device';
        }

        function snapToValid(raw) {
            var best = VALID_OFFS[0], bd = Math.abs(raw - best);
            VALID_OFFS.forEach(function(v) { var d=Math.abs(raw-v); if(d<bd){bd=d;best=v;} });
            return best;
        }

        // Seed selectedOff from saved timezone
        if (currentTz) {
            VALID_OFFS.forEach(function(off) {
                var k = String(off);
                if (TZ_DATA[k] && TZ_DATA[k].indexOf(currentTz) >= 0) selectedOff = off;
            });
            if (selectedOff === null) {
                try {
                    var raw = -new Date().getTimezoneOffset() / 60;
                    selectedOff = snapToValid(raw);
                } catch(e) {}
            }
        }

        function offToX(off) { return ((off - MIN_OFF) / RANGE) * canvas.width; }
        function xToOff(x)   { return MIN_OFF + (x / canvas.width) * RANGE; }

        function draw() {
            var w = canvas.width, h = canvas.height;
            var cs        = getComputedStyle(document.documentElement);
            var bgColor   = cs.getPropertyValue('--form-bg-color').trim()    || '#1a0a2e';
            var textColor = cs.getPropertyValue('--heading-color').trim()     || '#ffffff';
            var subColor  = cs.getPropertyValue('--text-color').trim()        || '#cccccc';
            var accentColor = cs.getPropertyValue('--link-color').trim()      || '#8c88f3';

            ctx.clearRect(0, 0, w, h);
            ctx.fillStyle = bgColor;
            ctx.fillRect(0, 0, w, h);

            // Day/night glow
            var utcH = new Date().getUTCHours() + new Date().getUTCMinutes()/60;
            for (var px = 0; px < w; px++) {
                var lh = ((utcH + xToOff(px)) % 24 + 24) % 24;
                if (lh >= 5 && lh <= 19) {
                    ctx.fillStyle = 'rgba(255,220,100,' + (Math.sin(Math.PI*(lh-5)/14)*0.13).toFixed(3) + ')';
                    ctx.fillRect(px, 0, 1, h);
                }
            }

            // Selected band
            if (selectedOff !== null) {
                var sx = offToX(selectedOff), bw = Math.max(4, w/RANGE*0.6);
                ctx.fillStyle = 'rgba(255,128,204,0.18)';
                ctx.fillRect(sx-bw, 0, bw*2, h);
                ctx.strokeStyle = 'rgba(255,128,204,0.9)'; ctx.lineWidth = 2;
                ctx.beginPath(); ctx.moveTo(sx,0); ctx.lineTo(sx,h); ctx.stroke();
            }

            // Hover dashes
            if (hoveredOff !== null && hoveredOff !== selectedOff) {
                var hx = offToX(hoveredOff);
                ctx.strokeStyle='rgba(255,128,204,0.38)'; ctx.lineWidth=1;
                ctx.setLineDash([4,4]);
                ctx.beginPath(); ctx.moveTo(hx,8); ctx.lineTo(hx,h); ctx.stroke();
                ctx.setLineDash([]);
            }

            // UTC grid lines + labels
            for (var o = MIN_OFF; o <= MAX_OFF; o++) {
                var gx = offToX(o);
                ctx.strokeStyle='rgba(128,128,128,0.2)'; ctx.lineWidth=1;
                ctx.beginPath(); ctx.moveTo(gx,h*0.45); ctx.lineTo(gx,h); ctx.stroke();
                if (o % 3 === 0) {
                    ctx.fillStyle = textColor; ctx.font='bold 10px monospace'; ctx.textAlign='center';
                    ctx.fillText((o>=0?'+':'')+o, gx, 13);
                }
            }

            // City dots + labels
            var lastX = -999;
            CITIES.forEach(function(c) {
                var cx = offToX(c.o);
                if (cx - lastX < 28) return;
                lastX = cx;
                ctx.fillStyle = accentColor;
                ctx.beginPath(); ctx.arc(cx, h*0.57, 2.5, 0, Math.PI*2); ctx.fill();
                ctx.fillStyle = subColor; ctx.font='8px sans-serif'; ctx.textAlign='center';
                ctx.fillText(c.n, cx, h*0.57+12);
            });
        }

        function showPills(offset, searchQ) {
            var pills = document.getElementById('tzPills');
            var info  = document.getElementById('tzOffsetInfo');
            var list;
            if (searchQ && searchQ.length >= 2) {
                var q = searchQ.toLowerCase();
                list = [];
                // City name matches first
                CITY_TZ.forEach(function(c) {
                    if (c.n.toLowerCase().includes(q) && list.indexOf(c.iana) < 0) list.push(c.iana);
                });
                // Then IANA timezone name matches
                Object.values(TZ_DATA).forEach(function(arr) {
                    arr.forEach(function(tz) {
                        if (tz.toLowerCase().replace(/[/_]/g,' ').includes(q) && list.indexOf(tz) < 0) list.push(tz);
                    });
                });
                info.textContent = list.length ? 'Results (' + list.length + '). Click to save:' : 'No cities or timezones match.';
            } else if (offset !== null) {
                list = TZ_DATA[String(offset)] || [];
                info.textContent = list.length
                    ? 'UTC'+(offset>=0?'+':'')+offset+': click a timezone to save'
                    : 'No IANA timezones at this offset.';
            } else {
                pills.innerHTML=''; info.textContent='Click the band to pick a UTC offset.'; return;
            }
            pills.innerHTML = list.map(function(tz) {
                var cls = 'tz-pill' + (tz===currentTz?' active':'');
                var cityMatch = searchQ && searchQ.length >= 2
                    ? CITY_TZ.find(function(c) { return c.iana === tz; })
                    : null;
                var label = cityMatch ? cityMatch.n + ' (' + tz + ')' : tz;
                return '<button type="button" class="'+cls+'" onclick="selectTz(\''+tz+'\')" title="'+tz+'">'+label+'</button>';
            }).join('');
        }

        window.selectTz = function(tz) {
            currentTz = tz;
            document.getElementById('tzHiddenInput').value = tz;
            document.getElementById('tzCurrentLabel').textContent = tz + ' selected';
            showPills(selectedOff, document.getElementById('tzSearch').value);
        };

        window.detectAndSetTimezone = function() {
            try {
                var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
                VALID_OFFS.forEach(function(off) {
                    if (TZ_DATA[String(off)] && TZ_DATA[String(off)].indexOf(tz) >= 0) selectedOff = off;
                });
                selectTz(tz);
                draw();
                showPills(selectedOff);
            } catch(e) { alert('Could not detect timezone.'); }
        };

        canvas.addEventListener('mousemove', function(e) {
            var r = canvas.getBoundingClientRect();
            hoveredOff = snapToValid(xToOff((e.clientX-r.left)*(canvas.width/r.width)));
            draw();
            var tt = document.getElementById('tzTooltip');
            tt.textContent = 'UTC'+(hoveredOff>=0?'+':'')+hoveredOff;
            tt.style.display = 'block';
            tt.style.left = Math.min(e.clientX-r.left+8, r.width-80)+'px';
        });

        canvas.addEventListener('mouseleave', function() {
            hoveredOff = null; draw();
            document.getElementById('tzTooltip').style.display='none';
        });

        canvas.addEventListener('click', function(e) {
            var r = canvas.getBoundingClientRect();
            selectedOff = snapToValid(xToOff((e.clientX-r.left)*(canvas.width/r.width)));
            draw(); showPills(selectedOff);
        });

        document.getElementById('tzSearch').addEventListener('input', function() {
            var q = this.value.trim();
            if (q.length >= 2) showPills(null, q);
            else if (selectedOff !== null) showPills(selectedOff);
            else { document.getElementById('tzPills').innerHTML=''; document.getElementById('tzOffsetInfo').textContent='Click the band to pick a UTC offset.'; }
        });

        function resize() {
            canvas.width  = canvas.clientWidth || 580;
            canvas.height = 90;
            draw();
        }
        window.addEventListener('resize', resize);
        requestAnimationFrame(resize);

        if (selectedOff !== null) showPills(selectedOff);
        else document.getElementById('tzOffsetInfo').textContent = 'Click the band to pick a UTC offset.';
    })();

    function toggleAppPicker(sel) {
        var picker = sel.closest('form').querySelector('.popular-apps-picker');
        if (picker) picker.style.display = sel.value === 'app' ? 'block' : 'none';
        var urlLabel = sel.closest('form').querySelector('[name="url"]').previousElementSibling;
        if (urlLabel) urlLabel.textContent = sel.value === 'app' ? 'App URI (e.g. spotify:)' : 'URL';
    }

    function pickApp(btn, name, uri) {
        var form = btn.closest('form');
        form.querySelector('[name="name"]').value = name;
        form.querySelector('[name="url"]').value = uri;
    }
</script>
