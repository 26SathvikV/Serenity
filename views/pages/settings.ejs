<style>
    .settings-container {
        max-width: 640px;
        margin: 0 auto;
    }

    .service-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
        margin-top: 12px;
    }

    .service-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 16px 12px;
        background-color: var(--form-bg-color);
        border: 1px solid var(--form-border-color);
        border-radius: 10px;
        cursor: pointer;
        transition: border-color 0.2s;
        font-size: 0.9rem;
        color: var(--text-color);
        text-decoration: none;
    }

    .service-btn:hover {
        border-color: var(--link-color);
        color: var(--heading-color);
    }

    .service-btn.connected {
        border-color: var(--link-color);
        background-color: var(--table-header-bg-color);
    }

    .service-btn.unavailable {
        opacity: 0.45;
        cursor: not-allowed;
    }

    .service-btn.unavailable:hover {
        border-color: var(--form-border-color);
        color: var(--text-color);
    }

    .service-icon { font-size: 2rem; line-height: 1; }

    .service-status { font-size: 0.75rem; color: var(--link-color); }

    .playlist-picker {
        margin-top: 16px;
        padding: 16px;
        background-color: var(--form-bg-color);
        border: 1px solid var(--form-border-color);
        border-radius: 8px;
    }

    .playlist-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        border-radius: 5px;
        cursor: pointer;
        margin-bottom: 4px;
        transition: background 0.15s;
    }

    .playlist-item:hover { background-color: var(--table-header-bg-color); }

    .playlist-item.selected {
        background-color: var(--table-header-bg-color);
        border: 1px solid var(--link-color);
    }

    .alert-success {
        background-color: rgba(60, 140, 80, 0.2);
        border: 1px solid #3c8c50;
        color: #aaffbb;
        padding: 10px 14px;
        border-radius: 5px;
        margin-bottom: 16px;
        text-align: center;
    }

    .tz-pill {
        padding: 3px 11px;
        font-size: 0.77rem;
        border-radius: 20px;
        border: 1px solid var(--form-border-color);
        background: var(--form-bg-color);
        color: var(--text-color);
        cursor: pointer;
        white-space: nowrap;
        transition: border-color 0.12s, background 0.12s;
    }
    .tz-pill:hover { border-color: var(--link-color); color: var(--heading-color); }
    .tz-pill.active { border-color: var(--link-color); background: rgba(140,136,243,0.12); color: var(--heading-color); }
</style>

<div class="settings-container">

    <% if (locals.accountFlash === 'updated') { %>
    <div class="alert-success">Account details updated.</div>
    <% } else if (locals.accountFlash === 'password_changed') { %>
    <div class="alert-success">Password changed successfully.</div>
    <% } %>
    <% if (locals.accountError) { %>
    <div class="alert-error">
        <% if (locals.accountError === 'wrong_password') { %>Incorrect current password.<% } %>
        <% if (locals.accountError === 'password_mismatch') { %>New passwords do not match.<% } %>
        <% if (locals.accountError === 'password_short') { %>Password must be at least 6 characters.<% } %>
        <% if (locals.accountError === 'missing_fields') { %>Name and email are required.<% } %>
    </div>
    <% } %>
    <% if (flash === 'spotify') { %>
    <div class="alert-success">Spotify connected! Choose a playlist below.</div>
    <% } %>
    <% if (flash === 'applemusic') { %>
    <div class="alert-success">Apple Music connected! Choose a playlist below.</div>
    <% } %>
    <% if (error) { %>
    <div class="alert-error">
        <% if (error === 'no_client_id') { %>Spotify is unavailable right now. Please try again later.<% } %>
        <% if (error === 'spotify_denied') { %>Spotify connection was cancelled.<% } %>
        <% if (error === 'spotify_failed') { %>Couldn't connect to Spotify. Please try again.<% } %>
        <% if (error === 'am_failed') { %>Couldn't connect to Apple Music. Please try again.<% } %>
        <% if (error === 'spotify_external_invalid') { %>Enter a valid Spotify playlist link or URI.<% } %>
        <% if (!['no_client_id','spotify_denied','spotify_failed','am_failed','spotify_external_invalid'].includes(error)) { %>Something went wrong while connecting your music service. Please try again.<% } %>
    </div>
    <% } %>

    <!-- Account -->
    <div style="margin-bottom:36px;">
        <div class="section-header">
            <h2>Account</h2>
            <hr>
        </div>

        <form method="POST" action="/profile/update" style="margin-bottom:24px;">
            <div class="form-group">
                <label>Name</label>
                <input type="text" name="name" value="<%= user.name %>" required>
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" value="<%= user.email %>" required>
            </div>
            <button type="submit">Save Changes</button>
        </form>

        <form method="POST" action="/profile/password" style="margin-bottom:24px;">
            <div class="form-group">
                <label>Current password</label>
                <input type="password" name="currentPassword" required autocomplete="current-password">
            </div>
            <div class="form-group">
                <label>New password</label>
                <input type="password" name="newPassword" required autocomplete="new-password">
            </div>
            <div class="form-group">
                <label>Confirm new password</label>
                <input type="password" name="confirmPassword" required autocomplete="new-password">
            </div>
            <button type="submit">Change Password</button>
        </form>

        <details style="margin-top:8px;">
            <summary style="color:#c06060;cursor:pointer;font-size:0.9rem;list-style:none;display:flex;align-items:center;gap:6px;">
                <span>▸</span> Delete account
            </summary>
            <div style="margin-top:14px;padding:16px;border:1px solid rgba(180,80,80,0.35);border-radius:8px;">
                <p style="font-size:0.85rem;color:var(--link-color);margin-bottom:12px;">
                    This permanently deletes your account, all sessions, and all groups. Enter your password to confirm.
                </p>
                <form method="POST" action="/profile/delete" onsubmit="return confirm('Delete your account permanently? This cannot be undone.')">
                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" name="confirmPassword" required autocomplete="current-password">
                    </div>
                    <button type="submit" class="btn-danger">Delete My Account</button>
                </form>
            </div>
        </details>
    </div>

    <!-- Subscription -->
    <% if (!locals.hideMonetization) { %>
    <div style="margin-bottom:36px;">
        <div class="section-header">
            <h2>Subscription</h2>
            <hr>
        </div>
        <style>
            .plan-badge { display:inline-block; padding:2px 10px; border-radius:12px; font-size:0.75rem; font-weight:600; letter-spacing:0.04em; text-transform:uppercase; }
            .plan-free   { background:var(--blockquote-bg-color); color:var(--link-color); border:1px solid var(--form-border-color); }
            .plan-pro    { background:rgba(74,144,217,0.15); color:#4a90d9; border:1px solid rgba(74,144,217,0.4); }
            .plan-studio { background:linear-gradient(90deg,rgba(130,80,220,0.15),rgba(74,144,217,0.15)); color:#a07fe0; border:1px solid rgba(130,80,220,0.4); }
        </style>
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
            <span class="plan-badge plan-<%= locals.userPlan || 'free' %>"><%= locals.userPlan || 'free' %></span>
            <a href="<%= locals.billingUrl %>" target="_blank" rel="noopener" style="font-size:0.88rem;"><%= locals.isFree ? 'Upgrade Plan' : 'Manage Plan' %></a>
        </div>
        <p style="font-size:0.82rem;color:var(--link-color);margin-top:10px;margin-bottom:0;">
            <% if (locals.isFree) { %>Free: up to 15 sessions, 5 groups, and 5 templates. Upgrade for higher limits.<% } else if (locals.isPro) { %>Pro: up to 100 sessions, 20 groups, and 30 templates.<% } else { %>Studio: unlimited sessions, groups, and templates.<% } %>
        </p>
    </div>
    <% } %>

    <!-- Session Defaults -->
    <div style="margin-bottom:36px;">
        <div class="section-header">
            <h2>Session Defaults</h2>
            <hr>
        </div>
        <form method="POST" action="/settings">
            <div class="duration-inputs">
                <div class="form-group">
                    <label>Default work duration (min)</label>
                    <input type="number" name="defaultWorkDuration" value="<%= pref.defaultWorkDuration || 25 %>" min="1" max="180">
                </div>
                <div class="form-group">
                    <label>Default break duration (min)</label>
                    <input type="number" name="defaultBreakDuration" value="<%= pref.defaultBreakDuration || 5 %>" min="1" max="60">
                </div>
            </div>
            <button type="submit">Save Defaults</button>
        </form>

        <form method="POST" action="/settings" style="margin-top:16px;">
            <input type="hidden" name="_strictModePresent" value="1">
            <label style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;">
                <input type="checkbox" name="strictMode" value="on" <%= locals.strictMode ? 'checked' : '' %> onchange="this.form.submit()" style="margin-top:3px;flex-shrink:0;">
                <span>
                    <strong>Strict Mode</strong><br>
                    <span style="font-size:0.85rem;color:var(--link-color);">Can't skip to break or stop the session until all tasks are marked complete.</span>
                </span>
            </label>
        </form>
    </div>

    <!-- Calendar -->
    <div style="margin-bottom:36px;">
        <div class="section-header">
            <h2>Calendar</h2>
            <hr>
        </div>
        <form method="POST" action="/settings" id="calendarSettingsForm">
            <input type="hidden" name="timezone" id="tzHiddenInput" value="<%= locals.timezone || '' %>">

            <div class="form-group">
                <label>Week starts on</label>
                <select name="startDay" onchange="this.form.submit()">
                    <option value="monday"    <%= (locals.startDay||'monday')==='monday'    ?'selected':'' %>>Monday</option>
                    <option value="tuesday"   <%= (locals.startDay||'monday')==='tuesday'   ?'selected':'' %>>Tuesday</option>
                    <option value="wednesday" <%= (locals.startDay||'monday')==='wednesday' ?'selected':'' %>>Wednesday</option>
                    <option value="thursday"  <%= (locals.startDay||'monday')==='thursday'  ?'selected':'' %>>Thursday</option>
                    <option value="friday"    <%= (locals.startDay||'monday')==='friday'    ?'selected':'' %>>Friday</option>
                    <option value="saturday"  <%= (locals.startDay||'monday')==='saturday'  ?'selected':'' %>>Saturday</option>
                    <option value="sunday"    <%= (locals.startDay||'monday')==='sunday'    ?'selected':'' %>>Sunday</option>
                </select>
            </div>

            <div class="form-group">
                <label style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:6px;">
                    <span>Time zone</span>
                    <span id="tzPreferenceLabel" style="font-weight:normal;font-size:0.78rem;color:var(--link-color);"><%= locals.timezone ? 'Saved: ' + locals.timezone : 'Using device timezone' %></span>
                </label>
                <p style="font-size:0.78rem;color:var(--link-color);margin-bottom:10px;">Click the band to pick a UTC offset, then choose a timezone.</p>

                <div style="position:relative;border:1px solid var(--form-border-color);border-radius:8px;overflow:hidden;margin-bottom:8px;">
                    <canvas id="tzCanvas" style="display:block;width:100%;height:90px;cursor:crosshair;"></canvas>
                    <div id="tzTooltip" style="position:absolute;top:4px;left:4px;background:var(--blockquote-bg-color);border:1px solid var(--form-border-color);padding:2px 8px;border-radius:4px;font-size:11px;color:var(--text-color);display:none;pointer-events:none;white-space:nowrap;z-index:1;"></div>
                </div>

                <div id="tzOffsetInfo" style="font-size:0.8rem;color:var(--link-color);min-height:1.4em;margin-bottom:8px;"></div>

                <div id="tzPills" style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:10px;max-height:110px;overflow-y:auto;padding:1px 0;"></div>

                <div style="display:flex;gap:8px;">
                    <input type="text" id="tzSearch" placeholder="Search (e.g. Tokyo, Berlin, UTC)…" style="flex:1;min-width:0;">
                    <button type="button" onclick="detectAndSetTimezone()" style="flex-shrink:0;font-size:0.85rem;padding:8px 14px;">Detect</button>
                </div>

                <div id="tzCurrentLabel" style="margin-top:8px;font-size:0.85rem;color:var(--heading-color);">
                    <%= locals.timezone || 'Detecting device timezone...' %>
                </div>
            </div>

            <button type="submit">Save Calendar Settings</button>
        </form>
    </div>

    <!-- App Rules -->
    <div style="margin-bottom:36px;">
        <div class="section-header">
            <h2>App Rules</h2>
            <hr>
        </div>
        <p style="font-size:0.85rem;color:var(--link-color);margin-bottom:20px;">Allowed apps appear as quick links during focus sessions. Blocked apps are hidden from the switcher while a session is running. Desktop apps use a URI scheme (e.g. <code>spotify:</code>, <code>vscode://</code>).</p>

        <h3 style="font-size:1rem;margin-bottom:12px;">Allowed</h3>
        <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:4px;">
            <% (locals.whitelistedApps || []).forEach(function(app, i) { %>
            <div style="position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;width:80px;height:80px;background:var(--form-bg-color);border:1px solid var(--form-border-color);border-radius:16px;padding:8px;gap:4px;text-align:center;">
                <form method="POST" action="/settings/whitelist" style="position:absolute;top:4px;right:4px;margin:0;">
                    <input type="hidden" name="action" value="remove">
                    <input type="hidden" name="index" value="<%= i %>">
                    <button type="submit" style="background:none;border:none;font-size:0.7rem;cursor:pointer;padding:2px 4px;opacity:0.7;color:var(--text-color);" title="Remove">Remove</button>
                </form>
                <span style="font-size:0.75rem;line-height:1;"><%= app.appType === 'app' ? 'APP' : 'WEB' %></span>
                <span style="font-size:0.65rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%;"><%= app.name %></span>
            </div>
            <% }); %>
        </div>
        <% if (!(locals.whitelistedApps && whitelistedApps.length > 0)) { %>
        <p style="font-size:0.8rem;opacity:0.5;margin-bottom:4px;">None added.</p>
        <% } %>
        <details style="margin-top:10px;margin-bottom:24px;">
            <summary style="cursor:pointer;font-size:0.82rem;color:var(--link-color);">+ Add allowed app</summary>
            <form method="POST" action="/settings/whitelist" style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;margin-top:10px;">
                <input type="hidden" name="action" value="add">
                <div class="form-group" style="margin:0;flex:1;min-width:100px;">
                    <label style="font-size:0.75rem;">Name</label>
                    <input type="text" name="name" placeholder="e.g. Spotify" required>
                </div>
                <div class="form-group" style="margin:0;min-width:110px;">
                    <label style="font-size:0.75rem;">Type</label>
                    <select name="appType" onchange="toggleAppPicker(this)">
                        <option value="website">Website</option>
                        <option value="app">Desktop App</option>
                    </select>
                </div>
                <div class="popular-apps-picker" style="display:none;width:100%;margin-top:2px;">
                    <p style="font-size:0.7rem;opacity:0.5;margin:0 0 5px;">Quick pick:</p>
                    <div style="display:flex;flex-wrap:wrap;gap:4px;">
                        <button type="button" onclick="pickApp(this,'Spotify','spotify:')">Spotify</button>
                        <button type="button" onclick="pickApp(this,'VS Code','vscode:')">VS Code</button>
                        <button type="button" onclick="pickApp(this,'Slack','slack:')">Slack</button>
                        <button type="button" onclick="pickApp(this,'Discord','discord:')">Discord</button>
                        <button type="button" onclick="pickApp(this,'Notion','notion:')">Notion</button>
                        <button type="button" onclick="pickApp(this,'Zoom','zoommtg:')">Zoom</button>
                        <button type="button" onclick="pickApp(this,'Figma','figma:')">Figma</button>
                        <button type="button" onclick="pickApp(this,'Obsidian','obsidian:')">Obsidian</button>
                    </div>
                </div>
                <div class="form-group" style="margin:0;flex:2;min-width:150px;">
                    <label style="font-size:0.75rem;">URL</label>
                    <input type="text" name="url" placeholder="https://…" required>
                </div>
                <button type="submit" style="flex-shrink:0;">Add</button>
            </form>
        </details>

        <h3 style="font-size:1rem;margin-bottom:12px;">Blocked</h3>
        <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:4px;">
            <% (locals.blacklistedApps || []).forEach(function(app, i) { %>
            <div style="position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;width:80px;height:80px;background:var(--form-bg-color);border:1px solid var(--form-border-color);border-radius:16px;padding:8px;gap:4px;text-align:center;opacity:0.75;">
                <form method="POST" action="/settings/blacklist" style="position:absolute;top:4px;right:4px;margin:0;">
                    <input type="hidden" name="action" value="remove">
                    <input type="hidden" name="index" value="<%= i %>">
                    <button type="submit" style="background:none;border:none;font-size:0.7rem;cursor:pointer;padding:2px 4px;opacity:0.7;color:var(--text-color);" title="Remove">Remove</button>
                </form>
                <span style="font-size:0.75rem;line-height:1;"><%= app.appType === 'app' ? 'APP' : 'WEB' %></span>
                <span style="font-size:0.65rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%;"><%= app.name %></span>
            </div>
            <% }); %>
        </div>
        <% if (!(locals.blacklistedApps && blacklistedApps.length > 0)) { %>
        <p style="font-size:0.8rem;opacity:0.5;margin-bottom:4px;">None blocked.</p>
        <% } %>
        <details style="margin-top:10px;">
            <summary style="cursor:pointer;font-size:0.82rem;color:var(--link-color);">+ Add blocked app</summary>
            <form method="POST" action="/settings/blacklist" style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;margin-top:10px;">
                <input type="hidden" name="action" value="add">
                <div class="form-group" style="margin:0;flex:1;min-width:100px;">
                    <label style="font-size:0.75rem;">Name</label>
                    <input type="text" name="name" placeholder="e.g. YouTube" required>
                </div>
                <div class="form-group" style="margin:0;min-width:110px;">
                    <label style="font-size:0.75rem;">Type</label>
                    <select name="appType" onchange="toggleAppPicker(this)">
                        <option value="website">Website</option>
                        <option value="app">Desktop App</option>
                    </select>
                </div>
                <div class="popular-apps-picker" style="display:none;width:100%;margin-top:2px;">
                    <p style="font-size:0.7rem;opacity:0.5;margin:0 0 5px;">Quick pick:</p>
                    <div style="display:flex;flex-wrap:wrap;gap:4px;">
                        <button type="button" onclick="pickApp(this,'Spotify','spotify:')">Spotify</button>
                        <button type="button" onclick="pickApp(this,'VS Code','vscode:')">VS Code</button>
                        <button type="button" onclick="pickApp(this,'Slack','slack:')">Slack</button>
                        <button type="button" onclick="pickApp(this,'Discord','discord:')">Discord</button>
                        <button type="button" onclick="pickApp(this,'Notion','notion:')">Notion</button>
                        <button type="button" onclick="pickApp(this,'Zoom','zoommtg:')">Zoom</button>
                        <button type="button" onclick="pickApp(this,'Figma','figma:')">Figma</button>
                        <button type="button" onclick="pickApp(this,'Obsidian','obsidian:')">Obsidian</button>
                    </div>
                </div>
                <div class="form-group" style="margin:0;flex:2;min-width:150px;">
                    <label style="font-size:0.75rem;">URL</label>
                    <input type="text" name="url" placeholder="https://…" required>
                </div>
                <button type="submit" style="flex-shrink:0;">Block</button>
            </form>
        </details>
    </div>

    <!-- Music -->
    <div>
        <div class="section-header">
            <h2>Music</h2>
            <hr>
        </div>
        <p style="font-size:0.9rem;color:var(--link-color);margin-bottom:12px;">Connect a service to play music during sessions. Requires a premium subscription for full-track playback.</p>

        <div class="service-grid">

            <!-- Spotify -->
            <% if (spotifyConnected) { %>
            <div class="service-btn connected">
                <ion-icon class="service-icon" name="logo-spotify" aria-label="Spotify"></ion-icon>
                <span>Spotify</span>
                <span class="service-status"><%= pref.musicService === 'spotify' ? 'Active' : 'Connected' %></span>
            </div>
            <% } %>
            <% if (spotifyExternalConnected) { %>
            <div class="service-btn connected">
                <ion-icon class="service-icon" name="logo-spotify" aria-label="Spotify"></ion-icon>
                <span>Spotify</span>
                <span class="service-status"><%= pref.musicService === 'spotifyExternal' ? 'External' : 'Playlist saved' %></span>
            </div>
            <% } %>

            <!-- Apple Music -->
            <% if (appleMusicConnected) { %>
            <div class="service-btn connected">
                <span class="service-icon">AM</span>
                <span>Apple Music</span>
                <span class="service-status"><%= pref.musicService === 'applemusic' ? 'Active' : 'Connected' %></span>
            </div>
            <% } %>

            <!-- Deezer -->
            <% if (deezerActive) { %>
            <div class="service-btn connected">
                <span class="service-icon">DZ</span>
                <span>Deezer</span>
                <span class="service-status">Active</span>
            </div>
            <% } %>
        </div>

        <% if (!spotifyConnected && !spotifyExternalConnected && !appleMusicConnected && !deezerActive) { %>
        <p style="font-size:0.85rem;color:var(--link-color);margin-top:12px;">No music services are connected yet.</p>
        <% } %>

        <% if ((!spotifyConnected && spotifyClientId) || (!appleMusicConnected && appleMusicKeyId) || (!deezerActive && deezerAppId)) { %>
        <details style="margin-top:16px;" <%= (!spotifyConnected && !appleMusicConnected && !deezerActive) ? 'open' : '' %>>
            <summary style="cursor:pointer;font-size:0.85rem;color:var(--link-color);">Connect a music service</summary>
            <div class="service-grid" style="margin-top:12px;">
                <% if (!spotifyConnected && spotifyClientId) { %>
                <a href="/auth/spotify" class="service-btn">
                    <ion-icon class="service-icon" name="play-circle" aria-label="Spotify"></ion-icon>
                    <span>Spotify</span>
                    <span class="service-status">Connect</span>
                </a>
                <% } %>
                <% if (!appleMusicConnected && appleMusicKeyId) { %>
                <button class="service-btn" onclick="connectAppleMusic()" type="button">
                    <span class="service-icon">AM</span>
                    <span>Apple Music</span>
                    <span class="service-status">Connect</span>
                </button>
                <% } %>
                <% if (!deezerActive && deezerAppId) { %>
                <button class="service-btn" onclick="connectDeezer()" type="button" id="deezerConnectBtn">
                    <span class="service-icon">DZ</span>
                    <span>Deezer</span>
                    <span class="service-status">Connect</span>
                </button>
                <% } %>
            </div>
        </details>
        <% } %>

        <details style="margin-top:12px;" <%= spotifyExternalConnected ? '' : 'open' %>>
            <summary style="cursor:pointer;font-size:0.85rem;color:var(--link-color);">Use Spotify without connecting an account</summary>
            <form method="POST" action="/settings" style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;margin-top:12px;">
                <input type="hidden" name="_musicAction" value="saveSpotifyExternal">
                <div class="form-group" style="margin:0;flex:1;min-width:220px;">
                    <label for="spotifyExternalPlaylist">Spotify playlist link or URI</label>
                    <input id="spotifyExternalPlaylist" name="spotifyExternalPlaylist" type="text" maxlength="512" value="<%= spotifyExternalConnected ? 'spotify:playlist:' + pref.spotifyExternalPlaylistId : '' %>" placeholder="https://open.spotify.com/playlist/..." autocomplete="off">
                </div>
                <button type="submit">Use playlist</button>
                <% if (spotifyExternalConnected) { %>
                <button type="submit" name="removeSpotifyExternal" value="true" style="background:transparent;border:1px solid var(--form-border-color);color:var(--text-color);">Remove</button>
                <% } %>
            </form>
            <p style="font-size:0.8rem;color:var(--link-color);margin-top:8px;">Serenity opens the playlist in Spotify; playback and controls stay in the Spotify app or web player.</p>
        </details>

        <!-- Spotify playlist picker -->
        <% if (spotifyConnected) { %>
        <div class="playlist-picker">
            <p style="color:var(--heading-color);margin-bottom:10px;font-size:0.95rem;">
                Spotify playlist: <strong id="selectedName"><%= pref.musicService === 'spotify' && pref.musicPlaylistName ? pref.musicPlaylistName : 'None selected' %></strong>
            </p>
            <button type="button" onclick="loadSpotifyPlaylists()" style="margin-bottom:12px;">Browse Playlists</button>
            <input type="text" id="spotifySearch" placeholder="Search playlists..." oninput="filterSpotifyList(this.value)" style="width:100%;margin-bottom:10px;display:none;box-sizing:border-box;">

            <% if (spotifyPlaylists.length > 0) { %>
            <div id="spotifyPlaylistList">
                <%
                const _focusKw = ['work','study','school','lock in'];
                const _isFocus = name => _focusKw.some(kw => name.toLowerCase().includes(kw));
                const _sorted = [...spotifyPlaylists].sort((a,b) => {
                    const af = _isFocus(a.name), bf = _isFocus(b.name);
                    if (af && !bf) return -1;
                    if (!af && bf) return 1;
                    return 0;
                });
                %>
                <% _sorted.forEach(function(pl) { %>
                <div class="playlist-item<%= pref.musicService === 'spotify' && pref.musicPlaylistId === pl.id ? ' selected' : '' %>"
                     data-name="<%= pl.name.toLowerCase() %>"
                     onclick="selectPlaylist('spotify', '<%= pl.id %>', '<%= pl.name.replace(/'/g, "\\'") %>')">
                    <%= pl.name %>
                    <% if (pl.tracks) { %>
                    <span style="font-size:0.8rem;color:var(--link-color);margin-left:auto;"><%= pl.tracks.total %> tracks</span>
                    <% } %>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <div id="spotifyPlaylistList"></div>
            <% } %>
        </div>

        <form method="POST" action="/auth/spotify/disconnect" style="margin-top:12px;">
            <button type="submit" class="btn-danger btn-sm">Disconnect Spotify</button>
        </form>
        <% } %>

        <!-- Apple Music playlist picker -->
        <% if (appleMusicConnected) { %>
        <div class="playlist-picker">
            <p style="color:var(--heading-color);margin-bottom:10px;font-size:0.95rem;">
                Apple Music playlist: <strong><%= pref.musicService === 'applemusic' && pref.musicPlaylistName ? pref.musicPlaylistName : 'None selected' %></strong>
            </p>
            <button type="button" onclick="loadAppleMusicPlaylists()" style="margin-bottom:12px;">Browse Playlists</button>
            <input type="text" id="appleMusicSearch" placeholder="Search playlists..." oninput="filterPlaylistList('appleMusicPlaylistList', this.value)" style="width:100%;margin-bottom:10px;display:none;box-sizing:border-box;">
            <div id="appleMusicPlaylistList"></div>
        </div>

        <form method="POST" action="/auth/applemusic/disconnect" style="margin-top:12px;">
            <button type="submit" class="btn-danger btn-sm">Disconnect Apple Music</button>
        </form>
        <% } %>

        <!-- Deezer playlist picker -->
        <% if (deezerActive) { %>
        <div class="playlist-picker">
            <p style="color:var(--heading-color);margin-bottom:10px;font-size:0.95rem;">
                Deezer playlist: <strong><%= pref.musicPlaylistName || 'None selected' %></strong>
            </p>
            <button type="button" onclick="changeDeezerPlaylist()" style="margin-bottom:12px;">Change Playlist</button>
            <input type="text" id="deezerSearch" placeholder="Search playlists..." oninput="filterPlaylistList('deezerPlaylistList', this.value)" style="width:100%;margin-bottom:10px;display:none;box-sizing:border-box;">
            <div id="deezerPlaylistList"></div>
        </div>

        <form method="POST" action="/auth/deezer/disconnect" style="margin-top:12px;">
            <button type="submit" class="btn-danger btn-sm">Disconnect Deezer</button>
        </form>
        <% } %>

        <!-- Deezer inline playlist picker (shown after connecting) -->
        <div id="deezerConnectSection" style="display:none;" class="playlist-picker">
            <p style="color:var(--heading-color);margin-bottom:10px;font-size:0.95rem;">Choose a Deezer playlist:</p>
            <div id="deezerPickList"></div>
        </div>

    </div>

    <!-- Hidden playlist save form -->
    <form method="POST" action="/settings" id="playlistForm" style="display:none;">
        <input type="hidden" name="musicPlaylistId" id="playlistIdInput">
        <input type="hidden" name="musicPlaylistName" id="playlistNameInput">
        <input type="hidden" name="musicService" id="playlistServiceInput">
    </form>

</div>

<!-- DZ.js for Deezer (only if app ID configured) -->
<% if (deezerAppId) { %>
<div id="dzSettingsPlayer" style="position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;"></div>
<script src="https://e-cdns-files.dzcdn.net/js/min/dz.js"></script>
<% } %>

<!-- MusicKit JS for Apple Music (only if configured) -->
<% if (appleMusicKeyId) { %>
<script src="https://js-cdn.music.apple.com/musickit/v3/musickit.js" data-web-components async></script>
<% } %>

<script>
    // ── Playlist helpers ──────────────────────────────────────────────────────
    const FOCUS_KW = ['work', 'study', 'school', 'lock in'];

    function sortPlaylists(list, nameGetter) {
        const isFocus = p => FOCUS_KW.some(kw => nameGetter(p).toLowerCase().includes(kw));
        return [...list.filter(isFocus), ...list.filter(p => !isFocus(p))];
    }

    function filterPlaylistList(containerId, q) {
        const lq = q.toLowerCase();
        document.querySelectorAll('#' + containerId + ' .playlist-item').forEach(el => {
            const name = (el.dataset.name || el.textContent).toLowerCase();
            el.style.display = (!lq || name.includes(lq)) ? '' : 'none';
        });
    }

    function filterSpotifyList(q) {
        filterPlaylistList('spotifyPlaylistList', q);
    }

    function selectPlaylist(service, id, name) {
        document.getElementById('playlistIdInput').value = id;
        document.getElementById('playlistNameInput').value = name;
        document.getElementById('playlistServiceInput').value = service;
        document.getElementById('playlistForm').submit();
    }

    // ── Spotify ───────────────────────────────────────────────────────────────
    async function loadSpotifyPlaylists() {
        const container = document.getElementById('spotifyPlaylistList');
        const searchEl = document.getElementById('spotifySearch');
        container.innerHTML = '<p style="color:var(--link-color);font-size:0.9rem;">Loading...</p>';
        try {
            const res = await fetch('/api/spotify/playlists');
            const data = await res.json();
            const sorted = sortPlaylists(data.playlists || [], p => p.name);
            container.innerHTML = '';
            if (sorted.length === 0) {
                container.innerHTML = '<p style="color:var(--link-color);font-size:0.9rem;">No playlists found.</p>';
                return;
            }
            if (searchEl) searchEl.style.display = '';
            const currentId = '<%= pref.musicService === "spotify" ? (pref.musicPlaylistId || "") : "" %>';
            sorted.forEach(pl => {
                const item = document.createElement('div');
                item.className = 'playlist-item' + (pl.id === currentId ? ' selected' : '');
                item.dataset.name = pl.name.toLowerCase();
                item.appendChild(document.createTextNode(pl.name));
                if (pl.tracks) {
                    const meta = document.createElement('span');
                    meta.style.cssText = 'font-size:0.8rem;color:var(--link-color);margin-left:auto;';
                    meta.textContent = pl.tracks.total + ' tracks';
                    item.appendChild(meta);
                }
                item.onclick = () => selectPlaylist('spotify', pl.id, pl.name);
                container.appendChild(item);
            });
        } catch(e) {
            container.innerHTML = '<p style="color:#ffaaaa;font-size:0.9rem;">Could not load playlists. Please try again.</p>';
        }
    }

    // ── Apple Music ───────────────────────────────────────────────────────────
    let _amInstance = null;

    async function _ensureAppleMusic() {
        if (_amInstance) return _amInstance;
        const res = await fetch('/api/applemusic/developer-token');
        if (!res.ok) throw new Error('Developer token unavailable');
        const { token } = await res.json();
        await MusicKit.configure({ developerToken: token, app: { name: 'Serenity', build: '1.0.0' } });
        _amInstance = MusicKit.getInstance();
        return _amInstance;
    }

    async function connectAppleMusic() {
        try {
            const music = await _ensureAppleMusic();
            await music.authorize();
            const userToken = music.musicUserToken;
            if (!userToken) throw new Error('No user token returned');
            await fetch('/api/applemusic/usertoken', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userToken })
            });
            window.location.href = '/settings?connected=applemusic';
        } catch(e) {
            alert('Could not connect to Apple Music. Please try again.');
        }
    }

    async function loadAppleMusicPlaylists() {
        const container = document.getElementById('appleMusicPlaylistList');
        const searchEl = document.getElementById('appleMusicSearch');
        container.innerHTML = '<p style="color:var(--link-color);font-size:0.9rem;">Loading...</p>';
        try {
            const music = await _ensureAppleMusic();
            if (!music.isAuthorized) await music.authorize();
            const response = await music.api.music('/v1/me/library/playlists', { limit: 100 });
            const raw = (response && response.data && response.data.data) ? response.data.data : [];
            const sorted = sortPlaylists(raw, p => p.attributes.name);
            container.innerHTML = '';
            if (sorted.length === 0) {
                container.innerHTML = '<p style="color:var(--link-color);font-size:0.9rem;">No playlists found in your library.</p>';
                return;
            }
            if (searchEl) searchEl.style.display = '';
            const currentId = '<%= pref.musicService === "applemusic" ? (pref.musicPlaylistId || "") : "" %>';
            sorted.forEach(pl => {
                const item = document.createElement('div');
                item.className = 'playlist-item' + (pl.id === currentId ? ' selected' : '');
                item.dataset.name = pl.attributes.name.toLowerCase();
                item.appendChild(document.createTextNode(pl.attributes.name));
                const meta = document.createElement('span');
                meta.style.cssText = 'font-size:0.8rem;color:var(--link-color);margin-left:auto;';
                meta.textContent = (pl.attributes.trackCount || 0) + ' tracks';
                item.appendChild(meta);
                item.onclick = () => selectPlaylist('applemusic', pl.id, pl.attributes.name);
                container.appendChild(item);
            });
        } catch(e) {
            container.innerHTML = '<p style="color:#ffaaaa;font-size:0.9rem;">Could not load playlists. Please try again.</p>';
        }
    }

    // ── Deezer ────────────────────────────────────────────────────────────────
    <% if (deezerAppId) { %>
    let _deezerInited = false;

    function _initDeezer(withPlayer) {
        if (_deezerInited) return;
        _deezerInited = true;
        const cfg = {
            appId: '<%= deezerAppId %>',
            channelUrl: window.location.origin + '/deezer/channel'
        };
        if (withPlayer) {
            cfg.player = { container: 'dzSettingsPlayer', width: 0, height: 0 };
        }
        DZ.init(cfg);
    }

    function _renderDeezerPlaylists(playlists, containerId, searchElId) {
        const container = document.getElementById(containerId);
        container.innerHTML = '';
        if (!playlists || playlists.length === 0) {
            container.innerHTML = '<p style="color:var(--link-color);font-size:0.9rem;">No playlists found.</p>';
            return;
        }
        const sorted = sortPlaylists(playlists, p => p.title);
        const searchEl = searchElId ? document.getElementById(searchElId) : null;
        if (searchEl) searchEl.style.display = '';
        sorted.forEach(pl => {
            const item = document.createElement('div');
            item.className = 'playlist-item';
            item.dataset.name = pl.title.toLowerCase();
            item.appendChild(document.createTextNode(pl.title));
            const meta = document.createElement('span');
            meta.style.cssText = 'font-size:0.8rem;color:var(--link-color);margin-left:auto;';
            meta.textContent = (pl.nb_tracks || 0) + ' tracks';
            item.appendChild(meta);
            item.onclick = () => selectPlaylist('deezer', String(pl.id), pl.title);
            container.appendChild(item);
        });
    }

    function connectDeezer() {
        _initDeezer(false);
        DZ.login(function(response) {
            if (!response.authResponse) {
                alert('Deezer connection was cancelled or could not be completed. Please try again.');
                return;
            }
            DZ.api('/user/me/playlists', function(data) {
                document.getElementById('deezerConnectSection').style.display = 'block';
                _renderDeezerPlaylists(data.data, 'deezerPickList', null);
            });
        }, { perms: 'basic_access,manage_library' });
    }

    function changeDeezerPlaylist() {
        _initDeezer(false);
        DZ.login(function(response) {
            if (!response.authResponse) {
                alert('Deezer connection was cancelled or could not be completed. Please try again.');
                return;
            }
            DZ.api('/user/me/playlists', function(data) {
                document.getElementById('deezerConnectSection').style.display = 'block';
                _renderDeezerPlaylists(data.data, 'deezerPlaylistList', 'deezerSearch');
            });
        }, { perms: 'basic_access,manage_library' });
    }
    <% } %>

