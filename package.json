{
  "name": "serenity",
  "version": "2.0.0",
  "description": "Task management and focus timer app",
  "main": "electron.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test",
    "electron": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.sathvikv.serenity",
    "productName": "Serenity",
    "copyright": "Copyright © 2024 Sathvik Vemulapalli",
    "files": [
      "**/*",
      "!.env",
      "!.git/**",
      "!MUSIC_SETUP.txt",
      "!**/.DS_Store",
      "!**/node_modules/.cache/**",
      "!**/*.md"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "connect-mongo": "^6.0.0",
    "dotenv": "^16.0.0",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "ics": "^3.12.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.6.0",
    "node-ical": "^0.26.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "nodemon": "^3.0.0"
  }
}
